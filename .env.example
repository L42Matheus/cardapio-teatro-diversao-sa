# Copie este arquivo para .env e preencha com os valores reais.
# .env nunca deve ser commitado (ja esta no .gitignore).

# Banco de dados PostgreSQL. Local: rode `npm run db:local` (sobe um
# Postgres embutido sozinho) e use a connection string abaixo. Em producao
# (Railway): connection string do addon Postgres do seu projeto.
DATABASE_URL=postgresql://postgres:postgres@localhost:5488/postgres
DATABASE_SSL=false

# true = ambiente de homologacao da Efi; false = producao
EFI_SANDBOX=true

# Client ID / Client Secret gerados no painel da Efi (Area Pix > Aplicacoes)
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=

# Certificado .p12 baixado no painel da Efi. Use UMA das duas opcoes:
# - EFI_CERT_PATH: caminho local do arquivo (uso local/dev)
# - EFI_CERT_BASE64: conteudo do .p12 em base64 (uso no Railway/producao,
#   onde nao da pra montar um arquivo). Se as duas existirem, BASE64 ganha.
#   Gerar com: node -e "console.log(require('fs').readFileSync('certs/arquivo.p12').toString('base64'))"
EFI_CERT_PATH=./certs/efi-homologacao.p12
EFI_CERT_BASE64=

# Chave Pix cadastrada na conta Efi que vai receber os pagamentos
EFI_PIX_KEY=

# Token secreto aleatorio exigido como query param em /webhook/pix
# (gere um novo com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))")
WEBHOOK_PIX_TOKEN=

# Senha do usuario admin fixo (usuario "teatro"). Sem isso definido, cai no
# default inseguro 'neymar' — sempre definir antes de deploy real.
ADMIN_PASSWORD=
